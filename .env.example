# --- Database: MySQL. Hostinger: hPanel > Databases > create a database + user. Host is usually localhost. ---
# Special characters in the password must be URL-encoded (@ becomes %40, # becomes %23, / becomes %2F).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"

# --- Auth: 32+ random chars. Generate: openssl rand -base64 32 ---
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Public base URL used for links in emails ---
APP_URL="http://localhost:3000"

# --- Email via SMTP (Hostinger). Leave SMTP_HOST empty to log emails to the server console. ---
# Hostinger: host smtp.hostinger.com, port 465 (SSL) or 587 (STARTTLS). User = the full mailbox address.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER="desk@yourdomain.com"
SMTP_PASSWORD=""
# Must be the same mailbox (or an alias of it) or Hostinger rejects the message.
EMAIL_FROM="KalamDesk <desk@yourdomain.com>"

# --- Cron endpoints require: Authorization: Bearer $CRON_SECRET ---
CRON_SECRET="change-me-too"

# --- Phase 3: 32-byte base64 key for field-level AES-256-GCM (store in a secrets manager) ---
FIELD_ENCRYPTION_KEY=""

# Uploaded task files (local disk driver). Use an S3 driver on serverless hosts.
UPLOAD_DIR="./uploads"

# --- Phase 3: WhatsApp alerts (optional; off unless all three are set) ---
# Needs a WhatsApp Business Cloud API app and an approved message template whose body has exactly 3 variables.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE=""
WHATSAPP_LANG="en"
# Replies from WhatsApp (optional): the Meta app secret and a verify token you invent
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""

# Emergency only: comma-separated emails whose two-step sign-in is switched off at startup. Remove after use.
# RESET_2FA_EMAILS=""

# Optional: name of the first organisation created by the first-founder bootstrap (default Robokalam)
# BOOTSTRAP_ORG_NAME=""
