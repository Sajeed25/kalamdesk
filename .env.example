# --- Database (SQLite for dev; use a postgres:// URL + provider swap for production) ---
DATABASE_URL="file:./dev.db"

# --- Auth: 32+ random chars. Generate: openssl rand -base64 32 ---
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Public base URL used for links in emails ---
APP_URL="http://localhost:3000"

# --- Email (Resend). Leave RESEND_API_KEY empty to log emails to the server console. ---
RESEND_API_KEY=""
EMAIL_FROM="KalamDesk <desk@yourdomain.com>"

# --- Cron endpoints require: Authorization: Bearer $CRON_SECRET ---
CRON_SECRET="change-me-too"

# --- Phase 3: 32-byte base64 key for field-level AES-256-GCM (store in a secrets manager) ---
FIELD_ENCRYPTION_KEY=""

# Uploaded task files (local disk driver). Use an S3 driver on serverless hosts.
UPLOAD_DIR="./uploads"
