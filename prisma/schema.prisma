// KalamDesk data model (full: Phase 1 is implemented in the app; Phase 2/3 tables are
// created now so later phases need no destructive migration).
//
// MySQL (Hostinger). Enums/JSON are intentionally avoided (plain strings validated in
// src/lib/constants.ts). MySQL needs explicit sizes: VarChar for defaulted text (TEXT columns
// cannot have defaults), Text for long nullable/required bodies.
// All DateTime values are UTC; the UI renders Asia/Kolkata.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- People ----------

model Department {
  id        String  @id @default(cuid())
  name      String  @unique
  color     String  @default("#64748b")
  users     User[]
  tasks     Task[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique // official email, used for login + notifications
  name           String
  passwordHash   String
  role           String    @default("EMPLOYEE") // FOUNDER | MANAGER | EMPLOYEE | INTERN
  active         Boolean   @default(true)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  totpSecret     String? // Phase 3: 2FA for admins
  consentAt      DateTime? // DPDP Act: consent recorded at onboarding
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())

  profile        EmployeeProfile?
  sensitive      EmployeeSensitive?

  createdTasks   Task[]            @relation("TaskCreator")
  assignments    TaskAssignee[]
  comments       TaskComment[]
  activities     TaskActivity[]
  notifications  Notification[]
  dailyUpdates   DailyUpdate[]
  scoreEvents    ScoreEvent[]
  incentives     IncentiveAward[]
  referrals      Referral[]
  auditEntries   AuditLog[]
  managedUsers   EmployeeProfile[] @relation("ReportingManager")
}

model EmployeeProfile {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl         String? @db.VarChar(500)
  office           String   @default("Hyderabad") // Hyderabad | Warangal
  phone            String?
  personalEmail    String?
  emergencyContact String? @db.VarChar(255)
  joinedOn         DateTime?
  employmentType   String   @default("FULL_TIME") // FULL_TIME | INTERN | CONTRACT
  internStart      DateTime?
  internEnd        DateTime?
  managerId        String?
  manager          User?    @relation("ReportingManager", fields: [managerId], references: [id])
  title            String?
  whatsappOptIn    Boolean  @default(false) // explicit consent; WhatsApp alerts are never sent without it
}

// Phase 3: every column holds AES-256-GCM ciphertext (see src/lib/crypto.ts). Admin only.
model EmployeeSensitive {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountHolderEnc  String? @db.Text
  accountNumberEnc  String? @db.Text
  ifscEnc           String? @db.Text
  bankNameEnc       String? @db.Text
  upiIdEnc          String? @db.Text
  idType            String? // PAN | AADHAAR | PASSPORT | OTHER (the type is not secret; the number is)
  idNumberEnc       String? @db.Text
  last4             String? // the only part ever shown by default
  updatedAt         DateTime @updatedAt
}

// ---------- Tasks ----------

model Task {
  id            String   @id @default(cuid())
  title         String @db.VarChar(255)
  description   String   @default("") @db.VarChar(5000)
  status        String   @default("TODO") // TODO | IN_PROGRESS | BLOCKED | IN_REVIEW | DONE | CANCELLED
  priority      String   @default("P3") // P1 | P2 | P3 | P4
  complexity    Int      @default(2) // 1..5
  dueAt         DateTime?
  estimateHours Float?
  tags          String   @default("") @db.VarChar(200) // comma separated, optional filter only
  links         String   @default("") @db.VarChar(2000) // newline separated
  location      String? @db.VarChar(300) // field visits
  blockedReason String? @db.Text
  requiresProof Boolean  @default(false)
  proofNote     String? @db.Text
  selfInitiated Boolean  @default(false)
  initiativeAccepted Boolean @default(false)
  reviewState   String? // APPROVED | SENT_BACK
  impactStars   Int? // 0..5 founder rating
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  creatorId     String
  creator       User     @relation("TaskCreator", fields: [creatorId], references: [id])
  recurringRuleId String?
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id])
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignees     TaskAssignee[]
  checklist     TaskChecklistItem[]
  comments      TaskComment[]
  attachments   TaskAttachment[]
  activity      TaskActivity[]
  instances     TaskInstance[]
  scoreEvents   ScoreEvent[]

  @@index([status, dueAt])
  @@index([creatorId])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id])
  @@id([taskId, userId])
  @@index([userId])
}

model TaskChecklistItem {
  id     String  @id @default(cuid())
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text   String @db.VarChar(255)
  done   Boolean @default(false)
  position Int    @default(0)
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String @db.Text
  createdAt DateTime @default(now())
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName   String @db.VarChar(255)
  storageKey String // S3-compatible object key
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // CREATED | STATUS | ASSIGNED | PRIORITY | DUE | COMMENT | REVIEW | EDITED
  detail    String   @default("") @db.VarChar(1000)
  createdAt DateTime @default(now())
  @@index([taskId, createdAt])
}

// ---------- Phase 2: recurring ----------

model RecurringRule {
  id            String   @id @default(cuid())
  title         String @db.VarChar(255)
  description   String   @default("") @db.VarChar(2000)
  rrule         String // simplified: "WEEKLY;BYDAY=TU;AT=10:00" | "MONTHLY;BYMONTHDAY=1;AT=09:00" | "WEEKDAYS;AT=09:00"
  leadHours     Int      @default(12)
  priority      String   @default("P3")
  location      String? @db.VarChar(300)
  departmentId  String?
  assigneeIds   String   @default("") @db.VarChar(2000) // comma separated user ids
  creatorId     String
  active        Boolean  @default(true)
  tasks         Task[]
  instances     TaskInstance[]
}

model TaskInstance {
  id          String   @id @default(cuid())
  ruleId      String
  rule        RecurringRule @relation(fields: [ruleId], references: [id])
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  forDate     DateTime
  outcome     String   @default("PENDING") // PENDING | DONE | LATE | MISSED
  checkInAt   DateTime?
  checkInLat  Float?
  checkInLng  Float?
}

// ---------- Phase 2: updates + scoring ----------

model DailyUpdate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  forDate   String // YYYY-MM-DD in IST
  finished  String   @default("") @db.VarChar(2000)
  pending   String   @default("") @db.VarChar(2000)
  obstacles String   @default("") @db.VarChar(2000)
  createdAt DateTime @default(now())
  @@unique([userId, forDate])
}

model ScoreSetting {
  key   String @id
  value Float
}

model ScoreEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  kind      String // TASK_DONE | MISSED_RECURRING | OVERDUE_PENALTY | INITIATIVE | IMPACT
  points    Float
  breakdown String   @default("") @db.VarChar(1000) // human-readable formula shown on hover
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

// ---------- Phase 3: incentives, referrals, snapshots ----------

model IncentiveRule {
  id        String @id @default(cuid())
  name      String
  minPoints Float  @default(0)
  minOnTimePct Float @default(0)
  amountInr Int
  active    Boolean @default(true)
  kind      String  @default("THRESHOLD") // THRESHOLD (points + on-time %) | TOP_N (fixed reward for the top N)
  topN      Int?
  audience  String  @default("ALL") // ALL | EMPLOYEE | INTERN
  awards    IncentiveAward[]
}

model IncentiveAward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ruleId    String?
  rule      IncentiveRule? @relation(fields: [ruleId], references: [id])
  month     String // YYYY-MM
  amountInr Int
  reason    String @db.VarChar(500)
  approved  Boolean  @default(false)
  paid      Boolean  @default(false)
  referralId String? // set when the award is a referral reward
  createdAt DateTime @default(now())
}

model ReferralProgram {
  id          String   @id @default(cuid())
  name        String
  reward      String
  rewardInr   Int? // amount credited to the referrer's incentives when a referral converts
  validUntil  DateTime?
  active      Boolean  @default(true)
  referrals   Referral[]
}

model Referral {
  id           String   @id @default(cuid())
  programId    String
  program      ReferralProgram @relation(fields: [programId], references: [id])
  referrerId   String
  referrer     User     @relation(fields: [referrerId], references: [id])
  name         String
  contact      String
  organisation String?
  notes        String   @default("") @db.VarChar(2000)
  status       String   @default("SUBMITTED") // SUBMITTED | CONTACTED | QUALIFIED | CONVERTED | REWARD_PAID
  createdAt    DateTime @default(now())
}

model DashboardSnapshot {
  id        String   @id @default(cuid())
  period    String // WEEKLY | MONTHLY
  label     String
  payload   String @db.Text // serialized metrics
  shareSlug String   @unique
  createdAt DateTime @default(now())
}

// ---------- Cross-cutting ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // ASSIGNED | STATUS | COMMENT | BLOCKED | SENT_BACK | APPROVED | REMINDER | DIGEST
  title     String @db.VarChar(500)
  body      String   @default("") @db.VarChar(1000)
  url       String   @default("") @db.VarChar(255)
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String // e.g. USER_CREATED, SENSITIVE_REVEAL, SETTINGS_CHANGED
  target    String   @default("")
  meta      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Password reset / invite links. Only the SHA-256 of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
}

// Idempotency for scheduled jobs (digests, reminders): one row per (kind, key).
model JobRun {
  id        String   @id @default(cuid())
  kind      String
  key       String
  createdAt DateTime @default(now())
  @@unique([kind, key])
}

// =====================================================================
// Phase 4: NEW TABLES ONLY. No existing table or column is altered, so an
// older database keeps working if the code is deployed before this SQL runs
// (only the new screens fail until prisma/phase4-upgrade.sql is applied).
// =====================================================================

// One-time recovery codes for two-factor sign-in. Only a SHA-256 of each code is stored.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
}

// Offer letters / ID scans. The file CONTENT is AES-256-GCM encrypted before it is written to storage.
model IdDocument {
  id           String   @id @default(cuid())
  userId       String
  uploadedById String
  kind         String   // OFFER_LETTER | ID_PROOF | CONTRACT | OTHER
  fileName     String   @db.VarChar(255)
  storageKey   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  @@index([userId])
}

// Secret salt behind each person's private calendar-feed link; changing it revokes the old link.
model CalendarFeed {
  userId    String   @id
  salt      String
  createdAt DateTime @default(now())
}

// Optional "MM-DD" birthday, shown to the team on the celebrations card.
model PersonDate {
  userId   String @id
  birthday String
}

model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  type         String    @default("CASUAL") // CASUAL | SICK | UNPAID | OTHER
  fromDate     String    // YYYY-MM-DD (IST)
  toDate       String
  days         Float
  reason       String    @default("") @db.VarChar(500)
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  backupUserId String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?   @db.VarChar(300)
  createdAt    DateTime  @default(now())
  @@index([userId, status])
  @@index([fromDate, toDate])
}

model AttendanceLog {
  id         String    @id @default(cuid())
  userId     String
  forDate    String    // YYYY-MM-DD (IST)
  checkInAt  DateTime
  checkOutAt DateTime?
  @@unique([userId, forDate])
}

model ExpenseClaim {
  id           String    @id @default(cuid())
  userId       String
  title        String    @db.VarChar(200)
  category     String    // TRAVEL | FUEL | FOOD | STATIONERY | OTHER
  amountInr    Int
  spentOn      String    // YYYY-MM-DD
  notes        String    @default("") @db.VarChar(1000)
  receiptKey   String?
  receiptName  String?   @db.VarChar(255)
  receiptMime  String?
  status       String    @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED | PAID
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?   @db.VarChar(300)
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  @@index([userId, status])
}

model Lead {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(150)
  organisation String?   @db.VarChar(150)
  phone        String?
  email        String?
  source       String?
  stage        String    @default("NEW") // NEW | CONTACTED | DEMO | PROPOSAL | WON | LOST
  valueInr     Int?
  ownerId      String
  nextFollowUp DateTime?
  notes        String    @default("") @db.VarChar(2000)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  calls        LeadCall[]
  @@index([ownerId, stage])
  @@index([nextFollowUp])
}

model LeadCall {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  outcome   String   // CONNECTED | NO_ANSWER | CALL_BACK | NOT_INTERESTED | WRONG_NUMBER
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now())
  @@index([leadId])
  @@index([userId, createdAt])
}

// One report per field-visit task. Photos are ordinary task attachments.
model VisitReport {
  id        String   @id @default(cuid())
  taskId    String   @unique
  userId    String
  summary   String   @db.VarChar(2000)
  attendees Int?
  outcome   String   @default("GOOD") // GREAT | GOOD | NEEDS_FOLLOW_UP | PROBLEM
  followUp  String   @default("") @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskTemplate {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(100)
  title         String   @db.VarChar(200)
  description   String   @default("") @db.VarChar(2000)
  priority      String   @default("P3")
  complexity    Int      @default(2)
  estimateHours Float?
  departmentId  String?
  checklist     String   @default("") @db.VarChar(2000) // one item per line
  createdById   String
  createdAt     DateTime @default(now())
}

// Founder-created, time-boxed team challenges (e.g. a Diwali sprint). Progress is derived from existing data.
model Challenge {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  metric      String   // TASKS_DONE | POINTS | STANDUPS | KUDOS
  target      Int
  startsOn    String   // YYYY-MM-DD (IST)
  endsOn      String
  prize       String   @default("") @db.VarChar(200)
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
}
